<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- No Android 15+ (API 35) o edge-to-edge é obrigatório.
         Este opt-out restaura a barra de sistema clássica (wifi/bateria visíveis). -->
    <style name="Theme.Lumis" parent="Theme.AppCompat.DayNight.NoActionBar" tools:targetApi="35">
        <item name="android:statusBarColor">#F7F8FA</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">#F7F8FA</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
